# Firebase Authentication web API key (public client configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only Gmail SMTP configuration. Create an app password in Google Account security.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
# Optional overrides; Gmail defaults are smtp.gmail.com and 465. Port 587 is also supported.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
