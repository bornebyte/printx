# Firebase Authentication web API key (public client configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only Gmail SMTP configuration. Create an app password in Google Account security.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
# Optional overrides; Gmail defaults are smtp.gmail.com and 465.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
