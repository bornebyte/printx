# URL of the PrintX backend. Use HTTPS outside local development.
PRINTX_BACKEND_URL=http://localhost:4000

# Copy these values from the owner dashboard after connecting a printer agent.
PRINTX_AGENT_ID=
PRINTX_AGENT_TOKEN=

# The local dashboard is intentionally bound to this computer only.
PRINTX_AGENT_HOST=127.0.0.1
PRINTX_AGENT_PORT=47821

# mock is safe for development. system uses the operating system print spooler
# when a downloadable document path is available.
PRINTX_AGENT_PRINTER_MODE=mock
PRINTX_AGENT_POLL_INTERVAL_MS=5000

# Optional: keep agent state somewhere else.
# PRINTX_AGENT_DATA_FILE=./data/agent.json
