# Firestore is the default backend persistence mode.
PRINTX_STORAGE=firestore

# Firebase project used by the frontend and backend.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Use one server-only credential source. A file path is easiest for local development.
# Never commit this JSON file or expose it to frontend/.env.local.
FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000

# Optional local-only development fallback. Firestore remains the default.
# PRINTX_STORAGE=local
# PRINTX_DATA_FILE=./data/store.json
